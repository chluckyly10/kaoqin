# 考勤管理系统后端环境变量
# 复制此文件为 .env 并填写实际值

# 服务端口（Render 会自动注入 PORT，本地开发用 3000）
PORT=3000

# MySQL 数据库配置（本地开发）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=attendanceDB

# 生产环境示例（db4free.net 免费MySQL）：
# DB_HOST=db4free.net
# DB_PORT=3306
# DB_USER=your_username
# DB_PASSWORD=your_password
# DB_NAME=your_dbname

# JWT 配置
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# 文件上传/导出目录
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
